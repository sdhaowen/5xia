{
  "文件说明": "本地消息发送接收模拟器 · 示例消息方案文件。请在程序里点「导入方案JSON」按钮选择本文件,再挑选一组方案载入。",
  "适用课程": "清华版《信息科技》五年级下册 第2单元 第3课 智能种植项目设计——信息的发送与接收",
  "方案列表": [
    {
      "名称": "教材示例:温湿度大棚",
      "说明": "标准配置:温度→farm/temp→显示屏,湿度→farm/humi→水泵,光照→farm/light→补光灯,三条线路一一对应,主题全部匹配,无丢包。点「开始」后应能看到每条消息都顺利送达。适合第一次实验。",
      "发布主题": {
        "温度传感器": "farm/temp",
        "湿度传感器": "farm/humi",
        "光照传感器": "farm/light"
      },
      "订阅主题": {
        "显示屏": "farm/temp",
        "水泵": "farm/humi",
        "补光灯": "farm/light"
      },
      "消息格式": { "含单位": true, "含时间": false },
      "发送间隔": 6,
      "丢包率": 0,
      "ACK确认": true
    },
    {
      "名称": "主题写错了(排错练习)",
      "说明": "故障演练:温度传感器把主题打成了 farm/tmep(字母顺序错了),显示屏订的却是 farm/temp,所以温度消息到服务器后变红提示「无人订阅」,显示屏永远收不到温度!请找出写错的主题并在配置区改正,让显示屏重新收到消息。",
      "发布主题": {
        "温度传感器": "farm/tmep",
        "湿度传感器": "farm/humi",
        "光照传感器": "farm/light"
      },
      "订阅主题": {
        "显示屏": "farm/temp",
        "水泵": "farm/humi",
        "补光灯": "farm/light"
      },
      "消息格式": { "含单位": true, "含时间": false },
      "发送间隔": 6,
      "丢包率": 0,
      "ACK确认": true
    },
    {
      "名称": "多订阅者广播",
      "说明": "广播实验:显示屏、水泵、补光灯三个接收端都订阅了 farm/temp,温度传感器每发一条消息,服务器就复制成三份分别送达——发布数加1,送达数加3!湿度和光照传感器发的主题无人订阅,会在服务器处变红。想一想:哪些消息适合广播给多个设备?",
      "发布主题": {
        "温度传感器": "farm/temp",
        "湿度传感器": "farm/humi",
        "光照传感器": "farm/light"
      },
      "订阅主题": {
        "显示屏": "farm/temp",
        "水泵": "farm/temp",
        "补光灯": "farm/temp"
      },
      "消息格式": { "含单位": true, "含时间": true },
      "发送间隔": 8,
      "丢包率": 0,
      "ACK确认": true
    }
  ]
}
